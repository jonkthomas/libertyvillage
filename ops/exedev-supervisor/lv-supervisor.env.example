# No secrets belong in this file. exe.dev integrations provide GitHub and LLM access.
LV_WEEKLY_OWNER=gha
LV_GITHUB_REPOSITORY=jonkthomas/libertyvillage
LV_STATE_DIR=/var/lib/lv-supervisor
LV_LEDGER=/var/lib/lv-supervisor/ledger.json
GH_HOST=github.int.exe.xyz
PATH=/home/exedev/.local/bin:/usr/local/bin:/usr/bin:/bin
GITHUB_API_URL=https://github.int.exe.xyz/api/v3
# exe.dev-only transparent App authentication. The shared client rejects this opt-in unless
# GITHUB_API_URL is pinned to HTTPS on the exact github.int.exe.xyz host above.
LV_EXE_GITHUB_PROXY_AUTH=true
PI_PROVIDER=openai
PI_MODEL=gpt-5.6-sol
PI_BASE_URL=https://llm.int.exe.xyz/v1
# Set only if the preinstalled pi package is outside `npm root --global`.
# PI_SDK_PATH=/home/exedev/.local/share/pi/node_modules/@earendil-works/pi-coding-agent
# Every active run executes this trusted staging-branch wrapper before candidate planning.
LV_SEO_CONTEXT=/var/lib/lv-supervisor/context/seo-data-latest.json
# Host-only ignored credential; the staging worktree must never contain this secret.
LV_GCP_CREDENTIALS_PATH=/home/exedev/libertyvillage/gcp-credentials.json
# Snapshot must be newer than this many hours.
LV_SEO_MAX_AGE_HOURS=48
LV_SEO_PREFETCH_COMMAND=ops/exedev-supervisor/refresh-seo.sh
# Optional alert integration, preferably injected by systemd credential/proxy configuration.
# SLACK_WEBHOOK_URL=
