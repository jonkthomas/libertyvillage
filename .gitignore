# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# google cloud credentials
gcp-credentials.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/screenshots/

# data build scripts
data/build-*.js
data/generate-*.js
data/combine-*.js
data/topics-part*.json

# local run scratch / regenerated state
/tasks/qa-loop-state.json
/tasks/seo-analysis.json
# superseded dated PRD snapshots
/archive/
# duplicate of generate-placeholder-images.mjs
/scripts/generate-placeholder-images.js

# weekly SEO agent run artifacts (PR body / run logs; ephemeral)
/tasks/seo-improve-summary.md
/tasks/seo-improve-runs/
/tasks/seo-scores.json

# local news discovery pilot artifacts (shadow-mode only)
.news-pilot/
